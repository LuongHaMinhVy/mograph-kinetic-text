# Copy this file to `.env.local` and fill in your credentials.
# `.env.local` is git-ignored and loaded automatically by `pnpm run align:lyrics`.
#
# Or connect automatically via ElevenLabs CLI:
#   pnpm dlx @elevenlabs/cli@latest onboard connect --env-path .env.local

# Required only for live lyric alignment / STT (`pnpm run align:lyrics` without cache)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
